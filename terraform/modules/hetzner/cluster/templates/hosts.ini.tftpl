[k3s]
%{ for node in nodes ~}
${node.name} ansible_host=${node.public_ip}  k3s_node_ip=${node.private_ip} ansible_user=${admin_user}
%{ endfor }
[k3s_control]
${control_node}
%{ if length(agent_nodes) > 0 ~}
[k3s_agent]
%{ for key, agent in agent_nodes ~}
${agent.name} ansible_host=${agent.public_ip}  k3s_node_ip=${agent.private_ip} ansible_user=${admin_user}  k3s_role=agent  k3s_labels=${jsonencode(agent.labels)}  k3s_taints=${jsonencode(agent.taints)}
%{ endfor ~}
%{ endif ~}
